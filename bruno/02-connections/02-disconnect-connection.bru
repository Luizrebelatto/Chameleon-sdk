meta {
  name: Disconnect Connection
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/connections/{{connectionId}}/disconnect
  body: none
  auth: none
}

headers {
  authorization: Bearer {{secretKey}}
  idempotency-key: {{idempotencyKey}}
}

script:pre-request {
  bru.setVar("idempotencyKey", `bruno-${Date.now()}`);
}

tests {
  test("disconnects the connection", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("DISCONNECTED");
  });
}
