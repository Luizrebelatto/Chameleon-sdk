meta {
  name: Get Reconnected Connection
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/connections/{{connectionId}}
  body: none
  auth: none
}

headers {
  authorization: Bearer {{secretKey}}
}

tests {
  test("keeps the same connection id and awaits authorization", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("connectionId"));
    expect(res.body.status).to.equal("PENDING");
  });
}
