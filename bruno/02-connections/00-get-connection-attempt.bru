meta {
  name: Get Connection Attempt
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/connection_attempts/{{attemptId}}
  body: none
  auth: none
}

headers {
  authorization: Bearer {{secretKey}}
}

tests {
  test("returns a credential-free connection attempt", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("attemptId"));
    expect(res.body.connectionId).to.equal(bru.getVar("connectionId"));
    expect(JSON.stringify(res.body)).not.to.include("refreshToken");
  });
}
